# textwire server configuration. Copy to .env (gitignored) and fill in what you need.
# Every variable is optional except where noted; the value shown is the default.
# docs/OPERATIONS.md explains each one in more detail.

# --- Process -------------------------------------------------------------------------
TEXTWIRE_ENVIRONMENT=local
TEXTWIRE_LOG_LEVEL=INFO
# console for a terminal, json for a log collector.
TEXTWIRE_LOG_FORMAT=console
TEXTWIRE_HOST=127.0.0.1
TEXTWIRE_PORT=8140
# Where the SQLite database (documents, frames, budget) lives.
TEXTWIRE_DATA_DIR=data

# --- Who may use the server (required for the real server) ---------------------------
# Comma-separated E.164 numbers. Everyone else is ignored and costs nothing.
TEXTWIRE_ALLOWED_NUMBERS=

# --- Transport ------------------------------------------------------------------------
# twilio or gateway (a spare Android phone running SMS Gateway for Android).
TEXTWIRE_TRANSPORT=twilio
# poll (no public URL needed) or webhook (Twilio posts to TEXTWIRE_PUBLIC_BASE_URL).
TEXTWIRE_INBOUND=poll
TEXTWIRE_POLL_SECONDS=3.0
# How far back the first poll after a start looks for requests that arrived while down.
TEXTWIRE_LOOKBACK_MINUTES=60
TEXTWIRE_SEND_RETRIES=3
# Pause between frames of one response. 0 lets Twilio pace them (about 10 per second).
TEXTWIRE_SEND_GAP_MS=0
TEXTWIRE_STATUS_INTERVAL_SECONDS=60.0

# Twilio (required when TEXTWIRE_TRANSPORT=twilio)
TEXTWIRE_TWILIO_ACCOUNT_SID=
TEXTWIRE_TWILIO_AUTH_TOKEN=
TEXTWIRE_TWILIO_NUMBER=
TEXTWIRE_TWILIO_API_BASE=https://api.twilio.com
# Only for TEXTWIRE_INBOUND=webhook: the public https URL Twilio calls, without a path.
TEXTWIRE_PUBLIC_BASE_URL=

# SMS Gateway for Android (required when TEXTWIRE_TRANSPORT=gateway)
TEXTWIRE_GATEWAY_URL=
TEXTWIRE_GATEWAY_USERNAME=
TEXTWIRE_GATEWAY_PASSWORD=

# --- Money ----------------------------------------------------------------------------
# Hard cap on outbound SMS segments per UTC day. Every frame is one segment.
TEXTWIRE_DAILY_SEGMENT_BUDGET=200
# Used for the cost estimate the phone shows. Twilio UK outbound was $0.056 in 2026-09.
TEXTWIRE_PRICE_PER_SEGMENT=0.056
TEXTWIRE_CURRENCY=USD

# --- Pages and searches ---------------------------------------------------------------
# How frame bytes are written as SMS text: b64 (120 bytes per SMS, default) or z85g
# (127 bytes per SMS). Switch to z85g only after `textwire probe` (or the dashboard's
# probe) has shown the phone decoding a z85g frame without a CRC error.
TEXTWIRE_FRAME_ALPHABET=b64
# Frames (SMS) per page when a request does not say. 12 frames is about 700-900 words.
TEXTWIRE_PAGE_FRAMES=12
TEXTWIRE_MAX_PAGE_FRAMES=40
# Messages per page in plain mode (requests ending in !), 1 to 9.
TEXTWIRE_PLAIN_MESSAGES=4
TEXTWIRE_SEARCH_RESULTS=5
TEXTWIRE_SEARCH_REGION=uk-en
TEXTWIRE_SEARCH_BACKEND=auto
TEXTWIRE_SEARCH_TIMEOUT_SECONDS=20.0
# off, moderate or strict filtering of explicit results.
TEXTWIRE_SEARCH_SAFESEARCH=moderate
# Characters of each result's summary, 20 to 300; 0 leaves summaries out (the cheapest
# search: about half the SMS).
TEXTWIRE_SEARCH_SNIPPET_CHARS=160
TEXTWIRE_FETCH_TIMEOUT_SECONDS=20.0
TEXTWIRE_FETCH_MAX_BYTES=3000000
# Redirects followed before a fetch gives up, 0 to 10. Every hop is checked.
TEXTWIRE_FETCH_MAX_REDIRECTS=5
# Leave unset to use the built-in browser-like user agent.
# TEXTWIRE_USER_AGENT=
# The operator's dashboard at /. false leaves only /healthy and /ready.
TEXTWIRE_DASHBOARD=true

# --- Retention and rate limits --------------------------------------------------------
# How long documents and sent frames are kept for paging, links and resends.
TEXTWIRE_RETENTION_HOURS=24
# At most one "budget exhausted" or "bad request" notice per sender per interval.
TEXTWIRE_NOTICE_INTERVAL_MINUTES=10

# --- Debugging ------------------------------------------------------------------------
# Comma-separated frame numbers to skip once, in the first multi-frame response after
# startup. The acceptance run uses this to prove the phone recovers lost frames.
TEXTWIRE_DEBUG_DROP_ONCE=
